# Blog Backend Configuration
# Development defaults. Copy this file to .env before starting the backend.

JWT_SECRET=dev_jwt_secret

PORT=3001

NODE_ENV=development

FRONTEND_URL=http://localhost:5173

# Google OAuth
# Local callback configured in Google Cloud:
# http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Gmail SMTP app password
SMTP_USER=2775968902a@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
# Production only: comma-separated list of allowed CORS origins
# Production must use a strong JWT_SECRET instead of the development default.
# Example: CORS_ORIGIN=https://myblog.com,https://www.myblog.com
# Leave commented to allow all origins (default for development)
# CORS_ORIGIN=https://your-domain.com
