# Blog Backend Configuration
# Development defaults. Copy this file to .env before starting the backend.

JWT_SECRET=dev_jwt_secret

PORT=3001

NODE_ENV=development

# Production only: comma-separated list of allowed CORS origins
# Production must use a strong JWT_SECRET instead of the development default.
# Example: CORS_ORIGIN=https://myblog.com,https://www.myblog.com
# Leave commented to allow all origins (default for development)
# CORS_ORIGIN=https://your-domain.com
