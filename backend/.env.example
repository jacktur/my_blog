# Blog Backend Configuration
# Copy this file to .env and fill in your values

# JWT Secret: Generate a strong random key with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_secret_key

# Server port (default: 3001)
PORT=3001

# Environment: 'development' or 'production'
# In production mode, the backend will serve the built frontend from ../frontend/dist/
NODE_ENV=development

# Production only: comma-separated list of allowed CORS origins
# Example: CORS_ORIGIN=https://myblog.com,https://www.myblog.com
# Leave commented to allow all origins (default for development)
# CORS_ORIGIN=https://your-domain.com
