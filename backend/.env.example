# Blog Backend Configuration
# Development defaults. Copy this file to .env before starting the backend.

JWT_SECRET=replace_with_a_long_random_secret

PORT=3001

NODE_ENV=development

FRONTEND_URL=http://localhost:5173

# Google OAuth
# Local callback configured in Google Cloud:
# http://localhost:3001/auth/google/callback
# Production callback for 277596.xyz:
# https://api.277596.xyz/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Gmail SMTP app password
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
# Production only: comma-separated list of allowed CORS origins
# Production must use a strong unique JWT_SECRET.
# Example: CORS_ORIGIN=https://277596.xyz,https://www.277596.xyz
# Leave commented to allow all origins (default for development)
# CORS_ORIGIN=https://277596.xyz
