# Frontend Configuration
# Leave empty in local development to use the Vite proxy.

# Production API origin for axios requests and Google OAuth entrypoint.
VITE_API_ORIGIN=https://api.277596.xyz

# Optional. When omitted, WebSocket uses VITE_API_ORIGIN with ws/wss converted automatically.
# VITE_WS_ORIGIN=wss://api.277596.xyz
